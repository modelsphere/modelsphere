####################################################################################
# Qwen2.5-72B-Instruct on NVIDIA GPUs with SGLang -- one machine, four GPUs, one
# instance.
#
#   cp examples/nvidia-qwen.env .env
#   cp hosts.example hosts           # your machines, one address per line
#   ./up.sh
#
# Provenance, because the two halves of this file are not equally proven:
#   * The container-level choices -- the device flags, --ipc=host, the ulimits, the
#     NCCL settings and the host prerequisites in section 4 -- are what a production
#     H100/H800 fleet runs with, including the two failure modes they exist to avoid.
#   * The model-level numbers -- the parallel shape, the engine flags, the
#     concurrency cap -- are defaults, NOT benchmarked on this model. Section 5 says
#     how to replace them with your own measurement.
#
# The sections go from "you have to set this" to "leave it alone":
#
#   1. the model          what you are serving, and where its weights are
#   2. the shape          how the machines in `hosts` add up to instances
#   3. the engine         comes with the hardware and the model; this example has it
#   4. the accelerators   likewise -- the reason to start from an example at all
#   5. limits and access  worth tuning once you have measured your own load
#   6. plumbing           ports, registries, the compose network. Rarely touched.
####################################################################################


################################ 1. the model #####################################

# The path clients call: http://<gateway>:8080/qwen/v1/chat/completions
ROUTE=qwen

# What clients send as "model", and what the engine advertises on /v1/models.
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# The weights on each machine. Each machine needs its own copy -- there is no
# shared-storage path here.
MODEL_PATH=/mnt/disk0/models/Qwen/Qwen2.5-72B-Instruct


################################ 2. the shape #####################################
# What the machines in `hosts` add up to. They are taken in file order.
#
#   NODES_PER_INSTANCE=1  ->  one instance per machine, load balanced by the router.
#                             Right whenever the weights fit in one machine, which
#                             for a 72B at bf16 on 4 x 80 GiB they do: more
#                             throughput than spanning machines, no cross-machine
#                             collectives, and one failure costs one instance.
#   NODES_PER_INSTANCE=2  ->  every two machines are one instance, TP within a
#                             machine and PP across the two (set PP=2). For weights
#                             that do not fit in one machine. Read the multi-machine
#                             notes in section 4 before using it -- on NVIDIA that
#                             path has two host prerequisites that fail silently.
#
# TP x PP must equal DEVICES_PER_NODE x NODES_PER_INSTANCE, and the machine count
# must divide by NODES_PER_INSTANCE. render.sh checks both and says so.
#
# Four cards, not the whole machine: a 72B at bf16 needs about two 80 GiB cards for
# its weights, and the rest of the four becomes KV cache. Taking only what the model
# needs leaves the other cards for something else -- including a second deployment of
# this same stack.
#
# These two always change together, and render.sh rejects a shape where TP x PP does
# not match the devices in an instance:
#   the whole machine:   DEVICES_PER_NODE=8  TP=8
#   half of it:          DEVICES_PER_NODE=4  TP=4   <- as set here
# Which cards it gets is DOCKER_FLAGS in section 4, not these numbers.
#
# Two instances per machine is a shape this layout cannot express -- one deployment
# is one instance per machine. Run a second copy of docker/ with its own ROUTE,
# ENGINE_PORT and card list.
DEVICES_PER_NODE=4
NODES_PER_INSTANCE=1
TP=4
PP=1


################################ 3. the engine ####################################

ENGINE=sglang
ENGINE_PORT=8050

# Pin a tag. The floating one moves under you, and an engine that changes version
# without anyone deciding to is how a working deployment stops working.
ENGINE_IMAGE=lmsysorg/sglang:v0.5.15-cu129

# Engine flags, appended verbatim to the command render.sh builds.
#
# Tool-call and reasoning parsers are deliberately absent: the names are per model
# family AND per engine version, a name that does not exist is rejected at startup,
# and one from the wrong family silently mangles tool calls. Add them once you have
# checked what this build ships -- for Qwen that is usually `--tool-call-parser
# qwen25`. List them with:
#   docker run --rm --entrypoint python3 <ENGINE_IMAGE> -c \
#     "import sglang.srt.function_call.function_call_parser as p; print(sorted(p.FunctionCallParser.ToolCallParserEnum))"
#
# A JSON value needs single quotes of its own (`--flag '{"a":1}'`): these flags end
# up on a command line the shell parses, and bare JSON loses its double quotes and
# splits on the comma.
ENGINE_EXTRA_ARGS="--mem-fraction-static 0.85 --trust-remote-code"

# Replace the engine's whole command line, for an image that starts in its own way.
# Empty = render.sh builds it from ENGINE, the port, TP/PP and the multi-machine
# arguments. It runs through /bin/bash -c after PRE_START, the weights are at /model,
# and it must `exec` in the foreground. Placeholders, substituted per machine:
#   {HOST} this machine   {PORT}   {RANK}   {NNODES}   {LEADER}   {DIST_PORT}
#   {MODEL_NAME}   {TP}   {PP}
ENGINE_CMD=


############################# 4. the accelerators ##################################
# One variable for every extra container argument: devices, -e, mounts. There is no
# second variable for environment on purpose -- two places to set -e is two places to
# look. nerdctl takes the same flags.
#
# Already there for every engine, do not repeat:
#   --network host --ipc=host --ulimit memlock=-1 --ulimit stack=67108864
#   -v <MODEL_PATH>:/model:ro   and a cache directory
# (--ipc=host and the memlock ulimit are not optional for these engines: shared
# memory between the tensor-parallel workers and pinned memory for the collectives.)
#
# --gpus needs nvidia-container-toolkit on the machines.
#
# The card list must keep its inner quotes all the way to docker: docker's own parser
# splits the value on commas, so a bare device=0,1,2,3 arrives as device=0 plus 1, 2,
# 3 and the daemon rejects it with "cannot set both Count and DeviceIDs on device
# request". Measured. `--gpus all` (no list) hands over every card instead, which is
# right only when DEVICES_PER_NODE is the machine's whole count.
#
# Keep the value on ONE line: this file is read by the shell and by docker compose,
# and only one of those two is relaxed about line continuations.
DOCKER_FLAGS="--gpus '\"device=0,1,2,3\"' -e PYTORCH_ALLOC_CONF=expandable_segments:True -e NCCL_DEBUG=WARN"

# ── For a multi-machine instance (NODES_PER_INSTANCE > 1), add to the line above ──
#   --device /dev/infiniband
#   -e NCCL_SOCKET_IFNAME=<nic> -e GLOO_SOCKET_IFNAME=<nic>
#   -e NCCL_IB_HCA=<hca>            e.g. mlx5_0; leave it out for TCP
#   -e NCCL_NET_GDR_LEVEL=2         GPUDirect RDMA over InfiniBand (1 for RoCE)
#
# Naming the interface is not optional there. Left unset on a machine with several,
# NCCL picks one that cannot reach its peer: the model loads and then hangs at the
# first collective, with nothing in the log that says so.
#
# Two host-level prerequisites for multi-machine NVIDIA, both measured on a
# production cluster, and both failing in a way that looks like a hung engine rather
# than an error:
#
#   * PCIe ACS must be off on every bridge. With it on, GPU-to-NIC peer traffic is
#     redirected through the root complex and NCCL deadlocks during initialisation
#     whenever GDR is enabled -- the ranks print their NCCL version and then nothing,
#     and the engine never becomes ready. Plain host-memory RDMA is unaffected, so
#     an IB bandwidth test passes while the engine hangs. It also comes back after
#     every reboot, because the firmware re-enables it.
#       lspci -vvv | grep -c "ACSCtl.*SrcValid+"      # healthy: ~2, broken: dozens
#
#   * nvidia-peermem must stay loaded. On a long-running machine it unloads itself,
#     and then any container restart hangs in NCCL initialisation. A timer that
#     reloads it periodically is the fix; this is a host concern, not a container
#     one, and nothing in this directory can detect it for you.
PRE_START=


########################### 5. limits and access ###################################

# The only port clients need: http://<this host>:8080/<ROUTE>/v1/...
GATEWAY_PORT=8080

# The knobs from docs/openresty.md, written into the route. Nothing is queued: over a
# limit is an immediate 429 with Retry-After: 1, and every route has limits even if
# you change nothing.
#
# MAX_CONCURRENCY=32 is a default, NOT a measurement of this model -- and with four
# cards rather than eight there is roughly half the KV cache to admit into. The
# number that
# matters is how many of your requests fit in the KV cache at once, which depends on
# their length: at 50K input tokens a request can occupy tens of thousands of cache
# tokens, and a cap above what the cache holds does not buy throughput -- it buys
# queueing inside the engine, where the router cannot see it. To find yours, raise
# the load until TOTAL tokens/s stops improving, and read the pool size out of the
# engine's own startup log. Then set this to the concurrency where it peaked.
MAX_CONCURRENCY=32           # per instance; the route's static cap is this x healthy instances
TTFT_LIMIT_MS=30000
TPS_LIMIT_TPS=20
ADAPTIVE_CC=true
ADAPTIVE_CC_MIN_FRAC=0.4
# true adds an X-Routed-Peer header naming the instance that served the request --
# worth turning on while you are bringing a deployment up, since without request
# records there is otherwise nothing that says where a request went. Leave it off on
# a gateway reachable from outside: it exposes the backend's address.
EXPOSE_ROUTED_PEER=false
CART_MAX_LOAD=20

# Authentication is OFF while this is empty: openresty lets every request through and
# reports api_keys_configured=false in /_health_status. Fine on a private network,
# not fine on an exposed one -- and the /<route>/_* status endpoints have no
# authentication at all and list the engines' addresses.
# To turn it on, put `key:owner,key:owner` in a file named `keys` and name its
# directory here (e.g. ./keys), then reload openresty.
API_KEYS_DIR=

# Request/response records. Empty = off, and nothing is captured or sent; there is
# deliberately no fallback address. To turn them on set this to `bodylog` and bring
# the stack up with `docker compose --profile bodylog up -d`.
BODYLOG_LISTENER_HOST=


################################ 6. plumbing ######################################
# Rarely changed.

# docker, or nerdctl where there is no Docker daemon. On a machine that is also a
# Kubernetes node, nerdctl drives the containerd that is already there instead of
# adding a second image store. Both work; the flags in section 4 are the same.
CTR_CLI=docker
# nerdctl only. Keep it off k8s.io, which is kubelet's namespace: containers started
# there show up in crictl and kubelet's image GC may delete images no pod uses.
CTR_NAMESPACE=default

# Rendezvous port for the machines of one instance. Unused while
# NODES_PER_INSTANCE=1; must be free on every machine of a multi-machine instance.
DIST_PORT=29500

# How ./up.sh reaches the machines. Key-based login, one at a time. Where SSH and the
# data network are different addresses, that is the second column in `hosts`.
SSH_USER=root
SSH_OPTS="-o ConnectTimeout=20 -o BatchMode=yes"

# The routing layer runs wherever you run ./up.sh -- no accelerator needed. These
# images are published for amd64 and arm64. From mainland China, replace the 4pdosc/
# prefix with modelsphere.tencentcloudcr.com/4pdosc/ -- same tags, same digests.
OPENRESTY_IMAGE=4pdosc/llm-openresty:0.1.31
CART_IMAGE=4pdosc/cache_aware_router:0.6.6
BODYLOG_IMAGE=4pdosc/bodylog-listener:0.1.17

# The compose network, and the routers' addresses in it. Pinned because the generated
# route names CART by address: a route must not change meaning because containers
# started in a different order.
NET_SUBNET=172.31.9.0/24
OPENRESTY_IP=172.31.9.10
CART_IP=172.31.9.12
CART_PORT=8071
