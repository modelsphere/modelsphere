####################################################################################
# GLM-5.3-Flash (W8A8) on Ascend 910B4 -- one machine, eight NPUs, one instance.
#
#   cp examples/glm-5.3-flash-910b4.env .env
#   cp hosts.example hosts           # this machine (127.0.0.1); edit it for several
#   # set MODEL_PATH below, then:
#   ./up.sh
#
# Measured on 910B4 (64 GiB per NPU, aarch64, Kylin V10): the engine flags, the
# concurrency cap and the device handover below are what this model was benchmarked
# with there. Where a number came from a measurement rather than a default, the
# comment says so.
#
# The weights are 310 GiB, so they fit in one machine's 8 x 64 GiB: one instance per
# machine, no cross-machine collectives. Put four machines in `hosts` and you get
# four instances behind the router.
#
# The sections go from "you have to set this" to "leave it alone":
#
#   1. the model          what you are serving, and where its weights are
#   2. the shape          how the machines in `hosts` add up to instances
#   3. the engine         comes with the hardware and the model; this example has it
#   4. the accelerators   likewise -- the reason to start from an example at all
#   5. limits and access  worth tuning once you have measured your own load
#   6. ports, images and SSH      ports, registries, SSH. Rarely touched.
####################################################################################


################################ 1. the model #####################################

# What clients send as "model", and what the engine advertises on /v1/models. It
# also names the URL: http://<gateway>:8080/glm-5.3-flash/v1/chat/completions
# (lower-cased, without any "org/" prefix; set ROUTE to choose a different path).
MODEL_NAME=glm-5.3-flash

# The weights on each machine. Must be the W8A8 export -- the plain modelslim build,
# not the mxfp8 one, which is an A5 format and these are A2 cards. Each machine needs
# its own copy: there is no shared-storage path here.
MODEL_PATH=/data/models/GLM-5.3-Flash-w8a8


################################ 2. the shape #####################################
# What the machines in `hosts` add up to. They are taken in file order.
#
#   NODES_PER_INSTANCE=1  ->  one instance per machine, load balanced by the router.
#                             Right for this model: 310 GiB of weights fit in 512 GiB
#                             of HBM. More throughput than spanning machines, no
#                             cross-machine collectives, and one failure costs one
#                             instance rather than the lot.
#   NODES_PER_INSTANCE=2  ->  every two machines are one instance. For weights that
#                             do not fit in one machine -- not this model's case.
#
# TP x PP must equal DEVICES_PER_NODE x NODES_PER_INSTANCE, and the machine count
# must divide by NODES_PER_INSTANCE. render.sh checks both and says so.
# Keep TP=8 on this hardware rather than splitting the eight cards into data-parallel
# ranks: each rank builds its own KV pool, and measured TP2 x DP4 shrank the pool
# from 802,285 to 142,114 tokens and lost 36.5% throughput at 16 concurrent.
DEVICES_PER_NODE=8
NODES_PER_INSTANCE=1
TP=8
PP=1


################################ 3. the engine ####################################

# vllm (vllm-ascend): SGLang publishes NPU images for A3 and 950 only (the -cann*-a3 /
# -cann*-950 tags), none for A2, which is what 910B4 is.
ENGINE=vllm
ENGINE_PORT=8050

ENGINE_IMAGE=quay.io/ascend/vllm-ascend:v0.30.0rc2
# The build every number in this file was measured on: its arm64 manifest is
# sha256:7859b75177884252d2b703eff727831ccab4e33a8bde0a9b4ac7563facc98b33. If the
# tag is ever moved, pin that digest instead (quay.io/ascend/vllm-ascend@sha256:...).
# It carries vllm 0.30.0 / vllm_ascend 0.30.0rc2, which registers Glm5NextForCausalLM onto
# vllm_ascend.models.glm5next, so the NPU implementation is used rather than vLLM's
# generic path -- worth checking in whatever build you pin, because the generic path
# is not what these numbers were measured with. Do NOT take an "-a5-" tag: A5 is
# 950DT, this is A2 (910B4), and the capability tables differ where it matters
# (FP8 attention and the compressed-cache formats are A5-only).

# Engine flags, appended verbatim to the command render.sh builds (which already
# adds --tensor-parallel-size from TP). This is the vLLM-Ascend cookbook's A2
# colocated recipe, adapted from two nodes (DP2 x TP8) to one (DP1 x TP8), plus the
# three parser flags serving needs. The recipe AT ITS OWN CONTEXT AND MEMORY SETTING
# (--max-model-len=133120 --gpu-memory-utilization=0.85) was measured on one Ascend
# 910B4 node, 50K in / 1.5K out, 600s per point, engine-direct, against the previous
# configuration of this file on the same image and weights: 2608.6 vs 1400.0 TOTAL
# tok/s at 12 concurrent, 2794.6 vs 1558.4 at 16, 2707.3 vs 1836.1 at 20 -- peak
# 2794.6 at 16 (a 600s window; no long-window figure yet). Of the differences, one is
# isolated so far: VLLM_USE_V2_MODEL_RUNNER=1 alone is worth +30.8% at 16 concurrent
# and +14.5% at 20; the rest are measured only as a bundle. This file defaults to
# the 1M context instead, which changes both values. Measured the same way at 16
# concurrent: 2789.7 TOTAL tok/s (TTFT 73.1s) -- within noise of the 133120 setting,
# so the full context costs no throughput here, only some TTFT. A larger
# --max-num-batched-tokens=16384 measured +7.5% at 133120, but does not fit with the
# 1M context (the engine refuses: the KV pool falls 0.78 GiB short).
#
#   --quantization=ascend     load-bearing here, not belt-and-braces: this
#                             checkpoint's config.json carries NO quantization_config
#                             at all, so without the flag the W8A8 weights are liable
#                             to be read as something else. A wrong quantisation does
#                             not fail loudly -- it loads and answers nonsense.
#   --enable-expert-parallel  one of the flags this model needs to start at all.
#   --*-parser=glm47, --enable-auto-tool-choice
#                             NOT in the cookbook, which benchmarks /v1/completions and
#                             never parses anything. Serving needs them: without them
#                             tool calls are not parsed and reasoning text lands in
#                             `content`. They cost no throughput. Keep them together --
#                             vLLM refuses --enable-auto-tool-choice without a
#                             --tool-call-parser. Names are per model AND per engine
#                             version: one that does not exist is rejected at startup,
#                             one from the wrong family silently mangles tool calls.
#   --max-num-seqs=32, --seed=1024, cudagraph_capture_sizes
#                             as the cookbook has them.
#   --max-model-len=1048576, --gpu-memory-utilization=0.9
#                             the full context the weights declare (1M). The two move
#                             together: the engine refuses to start when one request
#                             of max-model-len does not fit in the KV pool ("To serve
#                             at least one request with the model's max seq len ...").
#                             At the cookbook's 0.85 the pool is 802,285 tokens -- too
#                             small for 1M. At 0.9 with these flags it is 1,103,697
#                             tokens, "Maximum concurrency for 1,048,576 tokens per
#                             request: 1.05x" (measured on two 910B4 servers, identical
#                             on both): one 1M request at a time. If your engine
#                             reports below 1.0 there, it will not serve; use 0.95 or
#                             the measured pair below.
#                             And 0.9 is itself one of the differences from the
#                             cookbook arm, so the 1.79-1.86x above does NOT describe
#                             this default: those figures were measured at
#                             --max-model-len=133120 --gpu-memory-utilization=0.85,
#                             the measured configuration -- set those two values for it.
#   --safetensors-load-strategy=lazy, --model-loader-extra-config (multithread)
#                             load time only -- how fast 310 GiB comes off disk, not how
#                             fast it serves -- and part of the measured configuration
#                             (the cookbook itself uses --safetensors-load-strategy
#                             prefetch and no loader config). With them the load takes
#                             ~18 minutes.
#   CPU binding               on by default in this build (enable_cpu_binding), so no
#                             --additional-config is needed for it.
#
# A JSON value needs single quotes of its own, as the four below have. These flags
# end up on a command line that the shell parses: bare JSON loses its double quotes
# AND splits on the comma, so the engine receives nonsense arguments rather than one
# object.
ENGINE_EXTRA_ARGS="--trust-remote-code --quantization=ascend --tool-call-parser=glm47 --reasoning-parser=glm47 --enable-auto-tool-choice --enable-expert-parallel --max-num-seqs=32 --seed=1024 --max-model-len=1048576 --max-num-batched-tokens=8192 --gpu-memory-utilization=0.9 --safetensors-load-strategy=lazy --limit-mm-per-prompt='{\"image\":1,\"video\":0}' --compilation-config='{\"cudagraph_mode\":\"FULL_DECODE_ONLY\",\"cudagraph_capture_sizes\":[4,8,16,32,64,96,128]}' --speculative-config='{\"method\":\"deepseek_mtp\",\"num_speculative_tokens\":3,\"enforce_eager\":true}' --model-loader-extra-config='{\"enable_multithread_load\":true,\"num_threads\":128}'"

# Replace the engine's whole command line, for an image that starts in its own way.
# Empty = render.sh builds it from ENGINE, the port, TP/PP and the multi-machine
# arguments. It runs through /bin/bash -c, the weights are at /model,
# and it must `exec` in the foreground. Placeholders, substituted per machine:
#   {HOST} this machine   {PORT}   {RANK}   {NNODES}   {LEADER}   {DIST_PORT}
#   {MODEL_NAME}   {TP}   {PP}
ENGINE_CMD=


############################# 4. the accelerators ##################################
# One variable for every extra container argument: devices, -e, mounts, a vendor
# runtime. There is no second variable for environment on purpose -- two places to
# set -e is two places to look. nerdctl takes the same flags.
#
# Already there for every engine, do not repeat:
#   --network host --ipc=host --ulimit memlock=-1 --ulimit stack=67108864
#   -v <MODEL_PATH>:/model:ro   and a cache directory
#
# Keep the value on ONE line: this file is read by the shell and by docker compose,
# and only one of those two is relaxed about line continuations.
#
# The flags, left to right:
#   --runtime ascend  the vendor OCI runtime, which mounts the devices and the driver
#       itself. docker takes a runtime NAME registered in /etc/docker/daemon.json, not a
#       path (a path fails: "unknown or invalid runtime name"):
#         "runtimes": {"ascend": {"path": "/usr/local/Ascend/Ascend-Docker-Runtime/ascend-docker-runtime"}}
#       then restart dockerd. nerdctl takes the path itself instead of the name. Verified on these machines: with it, a
#       container started by `docker run --runtime ascend -e
#       ASCEND_VISIBLE_DEVICES=0` has /dev/davinci0 and /dev/davinci_manager in it,
#       and needs no --privileged.
#       A `default_runtime_name = "ascend"` in containerd's CRI config does NOT cover
#       this -- that setting is kubelet's. Both docker and nerdctl default to runc
#       and need the runtime named, and the failure is quiet: the container runs with
#       no /dev/davinci* in it.
#       Where that runtime is not installed, hand the devices over instead:
#         --device /dev/davinci0 ... --device /dev/davinci7
#         --device /dev/davinci_manager --device /dev/devmm_svm --device /dev/hisi_hdc
#         -v /usr/local/Ascend/driver:/usr/local/Ascend/driver:ro
#         -v /usr/local/dcmi:/usr/local/dcmi:ro
#         -v /usr/local/bin/npu-smi:/usr/local/bin/npu-smi:ro
#   ASCEND_VISIBLE_DEVICES      read by that runtime: which NPUs to hand over. To
#       take fewer than all of them -- another tenant has some, say -- narrow this
#       (0-3, or 0,1,2,3) and set DEVICES_PER_NODE and TP to match.
#   ASCEND_RT_VISIBLE_DEVICES   read by the engine: which of them to use. Different
#       variable, different reader -- both are needed.
#   VLLM_ENGINE_READY_TIMEOUT_S  310 GiB takes ~18 minutes to load, 366s of that
#       capturing graphs. The default timeout is shorter than the load.
#   VLLM_USE_V2_MODEL_RUNNER=1  as the cookbook sets it. Measured alone over 0: +30.8%
#       at 16 concurrent, +14.5% at 20 -- the largest single difference found.
#   HCCL_OP_EXPANSION_MODE=AIV  the cookbook's collective expansion mode.
#   VLLM_RPC_TIMEOUT, VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS, HCCL_EXEC_TIMEOUT,
#   HCCL_CONNECT_TIMEOUT        timeouts only, the cookbook's values: long prefills at
#       high concurrency outlast the defaults.
#   PYTORCH_NPU_ALLOC_CONF       as measured on this hardware for this model. Note
#       for a multi-machine instance: the CUDA equivalent of this setting
#       (PYTORCH_ALLOC_CONF) was measured to kill one, because expandable segments
#       cannot be exported as CUDA IPC handles and the custom all-reduce needs that.
#       The NPU path has no such step, so the finding does not carry over -- but it
#       has not been measured across machines here either. Re-check it there rather
#       than assuming either way.
#
# For a multi-machine instance (NODES_PER_INSTANCE > 1) the collective interface goes
# here too: -e HCCL_IF_IP={HOST} -e HCCL_SOCKET_IFNAME=<nic> -e
# TP_SOCKET_IFNAME=<nic> -e GLOO_SOCKET_IFNAME=<nic>, where {HOST} is substituted per
# machine. Not needed here -- one machine means no cross-machine collective. Left
# unset on a multi-machine instance, the engine picks an interface that cannot reach
# its peer, and the model loads and then hangs at the first collective with nothing
# in the log that says so.
#
# NOT SET HERE, because it describes a machine rather than this model -- but needed to
# reproduce the figures above. They were measured with the container limited to
#     --cpus 32 --memory 768g
# on a 192-core / 1 TiB machine: a CFS quota of 32 CPUs with NO cpuset, so the cpu
# binding above still spread over every NUMA domain, plus a 768 GiB memory limit.
# Scale those to your own machine and add them to DOCKER_FLAGS if you are comparing
# against these numbers -- left out, the engine gets the whole machine, which is a
# different configuration: faster or slower, but not comparable.
DOCKER_FLAGS="--runtime ascend -e ASCEND_VISIBLE_DEVICES=0-7 -e ASCEND_RT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7 -e VLLM_USE_V2_MODEL_RUNNER=1 -e VLLM_ENGINE_READY_TIMEOUT_S=3600 -e PYTORCH_NPU_ALLOC_CONF=expandable_segments:True -e HCCL_BUFFSIZE=1024 -e HCCL_OP_EXPANSION_MODE=AIV -e VLLM_RPC_TIMEOUT=3600000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3000 -e HCCL_EXEC_TIMEOUT=3600 -e HCCL_CONNECT_TIMEOUT=1200 -e ASCEND_GLOBAL_LOG_LEVEL=1"


########################### 5. limits and access ###################################

# The gateway: http://<the machine you run ./up.sh on>:8080/<route>/v1/... (up.sh prints it)
# It answers any machine that can route there -- see the authentication note below.
#
# Substituted into the framework config up.sh extracts from the image, so it really
# does move the listener; it and CART_PORT have to be free on that machine, and an
# address:port value works too. (The image's other listener, the unauthenticated
# /healthz admin server on 8090, is always turned off -- nothing here uses it.)
GATEWAY_PORT=8080

# The knobs from docs/openresty.md, written into the route. Nothing is queued: with
# RATE_LIMIT=true, a request over a limit receives an immediate 429 with Retry-After: 1.
#
# MAX_CONCURRENCY is a generous default (100 per instance), not a measurement. What
# actually bounds useful concurrency is how many requests fit in the engine's KV pool
# at once; above that, requests queue inside the engine where the router cannot see
# them. For reference, measured on one Ascend 910B4 node at the cookbook's
# --gpu-memory-utilization=0.85: a pool of 802,285 tokens, ~15.6 requests of 50K in /
# 1.5K out, throughput peaking at 16 concurrent (2794.6 TOTAL tok/s; 2707.3 at 20,
# 600s window).
# Read the pool size from the engine's startup log ("KV cache size") and lower this
# (and CART_MAX_LOAD) to what fits for your request lengths.
# RATE_LIMIT turns the limits below on. It is off by default: every request is let
# through, and the limits only take effect once you set it to true.
RATE_LIMIT=false
MAX_CONCURRENCY=100          # per instance; the route's static cap is this x healthy instances
# 50K-token prompts at 16 concurrent average ~73s to first token on this hardware,
# mostly queueing behind each other's prefill; the generic 30s limit would reject
# that load with 429. Lower it if your prompts are short.
TTFT_LIMIT_MS=120000
TPS_LIMIT_TPS=20
ADAPTIVE_CC=true
ADAPTIVE_CC_MIN_FRAC=0.4
# CART's per-instance load cap (max_load); requests beyond it go to the next instance
# or wait. Lower it together with MAX_CONCURRENCY once you know what the KV pool holds.
CART_MAX_LOAD=50
# Largest request body accepted, in bytes -- by the gateway and by CART alike. 200 MiB:
# one base64-encoded image or clip inline in a multimodal request can exceed 10 MiB.
MAX_BODY_SIZE=209715200

# API keys: the gateway reads `keys` in this directory (`key:owner,key:owner`). No such
# file means no authentication -- every request is let through, and /_health_status
# reports api_keys_configured=false. Create or edit the file, then re-run ./up.sh.
API_KEYS_DIR=./keys


######################## 6. ports, images and SSH #################################
# Rarely changed.

# docker, or nerdctl where there is no Docker daemon. These machines are also
# Kubernetes nodes, where docker is a second image store next to the containerd
# kubelet uses, so nerdctl is the better choice there. Both work; the flags in
# section 4 are the same either way.
CTR_CLI=docker
# nerdctl only. Keep it off k8s.io, which is kubelet's namespace: containers started
# there show up in crictl and kubelet's image GC may delete images no pod uses.
CTR_NAMESPACE=default

# Rendezvous port for the machines of one instance. Unused while
# NODES_PER_INSTANCE=1; must be free on every machine of a multi-machine instance.
DIST_PORT=29500

# How ./up.sh reaches the machines. Key-based login, one at a time. Where SSH and the
# data network are different addresses, that is the second column in `hosts`.
SSH_USER=root
SSH_OPTS="-o ConnectTimeout=20 -o BatchMode=yes"

# The routing layer runs wherever you run ./up.sh -- no accelerator needed. These
# images are published for amd64 and arm64, so one of these aarch64 machines can host
# it too. Where Docker Hub is unreachable (common from mainland China), replace the
# 4pdosc/ prefix with modelsphere.tencentcloudcr.com/4pdosc/ -- a read-only mirror
# carrying the same tags and digests.
OPENRESTY_IMAGE=4pdosc/llm-openresty:0.1.31
CART_IMAGE=4pdosc/cache_aware_router:0.6.6

# CART's port on the control machine. The generated config binds it to 127.0.0.1,
# so only openresty reaches it; it needs to be free there.
CART_PORT=8071
