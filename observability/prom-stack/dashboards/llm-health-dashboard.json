    {
      "type": "table",
      "id": 5,
      "title": "组件健康(openresty / logserver / autoconfig / CART)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "网关与控制面组件的副本健康:就绪/期望 + 24h 重启次数。这些组件没有 ServiceMonitor(Prometheus 只 scrape 了 bodylog exporter),所以走 kube-state-metrics 的副本口径 —— 能发现「挂了/没起来/在反复重启」,但看不到进程内部指标(如 openresty 的 QPS 在上面的服务表里看)。CART 按服务分开部署,故有多行。",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(namespace,deployment)(kube_deployment_status_replicas_ready{deployment=~\"openresty|bodylog.*|autoconfig-controller|.*cart.*|decision-gen\"}) > bool 0) + (sum by(namespace,deployment)(kube_deployment_status_replicas_ready{deployment=~\"openresty|bodylog.*|autoconfig-controller|.*cart.*|decision-gen\"}) >= bool sum by(namespace,deployment)(kube_deployment_spec_replicas{deployment=~\"openresty|bodylog.*|autoconfig-controller|.*cart.*|decision-gen\"}))",
          "legendFormat": "状态",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum by(namespace,deployment)(kube_deployment_status_replicas_ready{deployment=~\"openresty|bodylog.*|autoconfig-controller|.*cart.*|decision-gen\"})",
          "legendFormat": "就绪",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum by(namespace,deployment)(kube_deployment_spec_replicas{deployment=~\"openresty|bodylog.*|autoconfig-controller|.*cart.*|decision-gen\"})",
          "legendFormat": "期望",
          "datasource": {
