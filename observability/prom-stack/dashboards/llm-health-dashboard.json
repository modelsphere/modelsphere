{
  "uid": "llm-health",
  "title": "服务健康总览",
  "tags": [
    "llm",
    "health"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 2,
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(bodylog_service_replicas{service!=\"unknown\"}, service)",
          "refId": "sv"
        },
        "regex": "/(.*?)(?:-leader)?$/",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "label": "service"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 2,
      "title": "服务健康总览",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "id": 3,
      "title": "当前服务健康",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "类 monitor 主页:每 service 一行 —— 状态(UP 绿/降级 橙=就绪<期望/DOWN 红)、就绪/期望/实际副本、QPS、并发(引擎侧 num_running 之和)、错误率、TTFT p95、出词速率(bodylog 口径,-leader 已归并)。副本三列:期望=工作负载 spec.replicas(LWS 取 LWS 本身),实际=EndpointSlice 全部(滚动更新时会比期望多出 maxSurge,那是正常 surge 不是降级),就绪=conditions.ready。错误率【只算 5xx】=服务侧错误;4xx 不计(含 400 客户端坏请求 / 499 客户端断连 / 429 限流,非服务健康信号)。>2% 橙 / >5% 红。",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(avg by(service, route)(label_replace(bodylog_service_replicas_ready{service=~\"$service\",service!=\"unknown\"}, \"service\", \"$1\", \"service\", \"(.*)-leader$\")))",
          "legendFormat": "就绪",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(sum by(service)(avg by(service, route)(label_replace(bodylog_service_replicas_desired{service=~\"$service\",service!=\"unknown\"}, \"service\", \"$1\", \"service\", \"(.*)-leader$\")))\n  or sum by(service)(avg by(service, route)(label_replace(bodylog_service_replicas{service=~\"$service\",service!=\"unknown\"}, \"service\", \"$1\", \"service\", \"(.*)-leader$\"))))",
          "legendFormat": "期望",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum by(service)(avg by(service, route)(label_replace(bodylog_service_replicas{service=~\"$service\",service!=\"unknown\"}, \"service\", \"$1\", \"service\", \"(.*)-leader$\")))",
          "legendFormat": "实际",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "sum by(service)(label_replace(rate(bodylog_requests_total{backend!=\"(none)\",service=~\"$service\",service!=\"unknown\"}[5m]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))\n  and on(service) (max by(service)(max_over_time(bodylog_service_replicas{service=~\"$service\",service!=\"unknown\"}[24h])) > 0)",
          "legendFormat": "QPS",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "(sum by(service)(label_replace(rate(bodylog_requests_total{status_class=\"5xx\",backend!=\"(none)\",service=~\"$service\",service!=\"unknown\"}[5m]), \"service\", \"$1\", \"service\", \"(.*)-leader$\")) or (0 * sum by(service)(label_replace(rate(bodylog_requests_total{backend!=\"(none)\",service=~\"$service\",service!=\"unknown\"}[5m]), \"service\", \"$1\", \"service\", \"(.*)-leader$\")))) / clamp_min(sum by(service)(label_replace(rate(bodylog_requests_total{backend!=\"(none)\",service=~\"$service\",service!=\"unknown\"}[5m]), \"service\", \"$1\", \"service\", \"(.*)-leader$\")),0.001)\n  and on(service) (max by(service)(max_over_time(bodylog_service_replicas{service=~\"$service\",service!=\"unknown\"}[24h])) > 0)",
          "legendFormat": "错误率",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(0.95, (((sum by(service)(label_replace(rate(bodylog_ttft_seconds{service=~\"$service\",service!=\"unknown\"}[5m]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))\n      - sum by(service)(label_replace(rate(bodylog_rt_seconds{stream=\"unknown\",service=~\"$service\",service!=\"unknown\"}[5m]), \"service\", \"$1\", \"service\", \"(.*)-leader$\")))\n      or sum by(service)(label_replace(rate(bodylog_ttft_seconds{service=~\"$service\",service!=\"unknown\"}[5m]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))) and on(service) ((abs(histogram_count(sum by(service)(label_replace(rate(bodylog_ttft_seconds{service=~\"$service\",service!=\"unknown\"}[$__rate_interval]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))) - sum by(service)(label_replace(rate(bodylog_requests_total{service=~\"$service\",service!=\"unknown\"}[$__rate_interval]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))) < bool abs(histogram_count(sum by(service)(label_replace(rate(bodylog_ttft_seconds{service=~\"$service\",service!=\"unknown\"}[$__rate_interval]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))) - (sum by(service)(label_replace(rate(bodylog_requests_total{stream=\"true\",service=~\"$service\",service!=\"unknown\"}[$__rate_interval]), \"service\", \"$1\", \"service\", \"(.*)-leader$\")) or (0 * histogram_count(sum by(service)(label_replace(rate(bodylog_ttft_seconds{service=~\"$service\",service!=\"unknown\"}[$__rate_interval]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))))))) == 1))\n  or (sum by(service)(label_replace(rate(bodylog_ttft_seconds{service=~\"$service\",service!=\"unknown\"}[5m]), \"service\", \"$1\", \"service\", \"(.*)-leader$\")) and on(service) ((abs(histogram_count(sum by(service)(label_replace(rate(bodylog_ttft_seconds{service=~\"$service\",service!=\"unknown\"}[$__rate_interval]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))) - sum by(service)(label_replace(rate(bodylog_requests_total{service=~\"$service\",service!=\"unknown\"}[$__rate_interval]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))) < bool abs(histogram_count(sum by(service)(label_replace(rate(bodylog_ttft_seconds{service=~\"$service\",service!=\"unknown\"}[$__rate_interval]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))) - (sum by(service)(label_replace(rate(bodylog_requests_total{stream=\"true\",service=~\"$service\",service!=\"unknown\"}[$__rate_interval]), \"service\", \"$1\", \"service\", \"(.*)-leader$\")) or (0 * histogram_count(sum by(service)(label_replace(rate(bodylog_ttft_seconds{service=~\"$service\",service!=\"unknown\"}[$__rate_interval]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))))))) == 0)))\n  and on(service) (max by(service)(max_over_time(bodylog_service_replicas{service=~\"$service\",service!=\"unknown\"}[24h])) > 0)",
          "legendFormat": "TTFT_p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "G",
          "expr": "sum by(service)(label_replace(rate(bodylog_completion_tokens_total{service=~\"$service\",service!=\"unknown\"}[1m]), \"service\", \"$1\", \"service\", \"(.*)-leader$\"))\n  and on(service) (max by(service)(max_over_time(bodylog_service_replicas{service=~\"$service\",service!=\"unknown\"}[24h])) > 0)",
          "legendFormat": "出词tok/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "H",
          "expr": "(sum by(service)(avg by(service, route)(label_replace(bodylog_service_replicas_ready{service=~\"$service\",service!=\"unknown\"}, \"service\", \"$1\", \"service\", \"(.*)-leader$\"))) > bool 0) + (sum by(service)(avg by(service, route)(label_replace(bodylog_service_replicas_ready{service=~\"$service\",service!=\"unknown\"}, \"service\", \"$1\", \"service\", \"(.*)-leader$\"))) >= bool (sum by(service)(avg by(service, route)(label_replace(bodylog_service_replicas_desired{service=~\"$service\",service!=\"unknown\"}, \"service\", \"$1\", \"service\", \"(.*)-leader$\")))\n  or sum by(service)(avg by(service, route)(label_replace(bodylog_service_replicas{service=~\"$service\",service!=\"unknown\"}, \"service\", \"$1\", \"service\", \"(.*)-leader$\")))))",
          "legendFormat": "状态",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "I",
          "expr": "sum by(service)(label_join(label_replace({__name__=~\"sglang:num_running_reqs|vllm:num_requests_running\"}, \"service\", \"$1\", \"service\", \"(.*?)(?:-leader)?\"), \"service\", \"/\", \"namespace\", \"service\"))\n  and on(service) (max by(service)(max_over_time(bodylog_service_replicas{service=~\"$service\",service!=\"unknown\"}[24h])) > 0)",
          "legendFormat": "并发",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "J",
          "expr": "round(sum by(service)(increase(kube_pod_container_status_restarts_total[24h])\n  * on(namespace,pod) group_left(service) (max by(namespace,pod,service)((0 * label_join(label_replace(max by(namespace,pod,service)({__name__=~\"sglang:num_running_reqs|vllm:num_requests_running\"}), \"service\", \"$1\", \"service\", \"(.*?)(?:-leader)?\"), \"service\", \"/\", \"namespace\", \"service\") + 1))\n   or max by(namespace,pod,service)(\n  label_replace(kube_pod_owner{owner_kind=\"StatefulSet\"}, \"leader_pod\", \"$1\", \"owner_name\", \"(.+)\")\n  * on(namespace,leader_pod) group_left(service)\n    label_replace((0 * label_join(label_replace(max by(namespace,pod,service)({__name__=~\"sglang:num_running_reqs|vllm:num_requests_running\"}), \"service\", \"$1\", \"service\", \"(.*?)(?:-leader)?\"), \"service\", \"/\", \"namespace\", \"service\") + 1), \"leader_pod\", \"$1\", \"pod\", \"(.+)\")))))\n  and on(service) (max by(service)(max_over_time(bodylog_service_replicas{service=~\"$service\",service!=\"unknown\"}[24h])) > 0)",
          "legendFormat": "重启24h",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        }
      ],
