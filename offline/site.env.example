# The one place the site's own facts are written. Copy to offline/site.env on
# the target and edit; every offline step reads it, so the registry address is
# written once instead of three times.
#
# It used to be three: environments/<cluster>.yaml (registry + chartRepo),
# kubeadm's --image-repository, and containerd's sandbox image. Three copies of
# one value drift, and each way of drifting fails somewhere different and
# unhelpfully -- pods stuck in ContainerCreating, or one component unable to
# pull while the rest are fine.

# Where the offline registry listens. Reachable from every node, so not
# 127.0.0.1 unless the registry runs on each of them.
REGISTRY=10.0.0.9:5000

# Plain HTTP unless the registry has a certificate. Set to false for https.
PLAIN_HTTP=true

# Credentials, if the registry has any. Needed in two places that do not share
# a credential store: `docker login` for the images, and `helm registry login`
# for the charts -- against an authenticated registry, doing only the first
# lets every image through and fails every chart with "basic credential not
# found". offline_load.sh does the helm half from these.
# REGISTRY_USER=offlineuser
# REGISTRY_PASS=
