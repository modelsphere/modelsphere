# swissd, the model deployment backend behind the console portal.
#
# The image follows registry (public Docker Hub by default in default.yaml,
# overridden to a private registry where a cluster has one). Tag follows the
# chart's appVersion, so an upgrade is a one-line change to versions.swiss.
image:
  repository: {{ .Values.registry }}/swissd

# No PVC by default: sqlite goes on an emptyDir, so the audit log and plan
# history go when the pod is replaced. Recommended: turn it on (needs a
# StorageClass or existingClaim), see docs/console.md.
persistence:
  enabled: false

# Console logs users in and calls swissd with the front-proxy key: the key is
# generated into swissd's auth Secret, which console reads directly (same
# namespace). The password login stays on beside it.
auth:
  proxyKey: true

# scope follows swiss.rbacScope (environments/default.yaml): cluster by default,
# anything but cluster or namespaced fails. namespaces only at namespaced scope,
# the namespaces holding model releases: every models[] entry's namespace,
# defaulting to llm-demo the way the model releases themselves do -- llm-demo
# when the cluster declares no models yet.
{{- $scope := dig "swiss" "rbacScope" nil .Values }}
{{- if kindIs "invalid" $scope }}
{{-   $scope = "cluster" }}
{{- end }}
{{- if not (has $scope (list "cluster" "namespaced")) }}
{{-   fail (printf "swiss.rbacScope is %q: it must be cluster or namespaced" (toString $scope)) }}
{{- end }}
rbac:
  scope: {{ $scope }}
{{- if eq $scope "namespaced" }}
  namespaces:
{{- $swissNs := list }}
{{- range $m := (dig "models" (list) .Values) }}
{{-   $swissNs = append $swissNs (dig "namespace" "llm-demo" $m) }}
{{- end }}
{{- if not $swissNs }}
{{-   $swissNs = list "llm-demo" }}
{{- end }}
{{- range $ns := $swissNs | uniq }}
      - {{ $ns | quote }}
{{- end }}
{{- end }}
