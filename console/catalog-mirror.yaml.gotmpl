# catalog-mirror: the model catalog and the engine chart repository, served in
# the cluster for swissd (console/swiss-overrides.yaml.gotmpl points it here).
#
# Two ways to fill it, chosen by catalogSnapshot:
#   set     an air-gapped cluster. The bundle's catalog-snapshot.tar.gz arrives as a
#           ConfigMap (the presync hook on this release creates it) and is
#           unpacked on every pod start; nothing syncs, since there is nothing
#           to sync from. No volume is needed -- the snapshot refills an emptyDir.
#   empty   a cluster that reaches GitHub, slowly or now and then: the chart's
#           own sync copies GitHub Pages every five minutes, onto a PVC when
#           storage.persistence is on.
{{- $snapshot := .Values.catalogSnapshot | default "" }}
{{- /* Absolute only: helmfile resolves a relative path in this file against
       console/, while the presync hook runs from the helmfile's directory, so
       one relative spelling cannot satisfy both -- ./offline/... would be
       found by neither consistently. */}}
{{- if and $snapshot (not (isAbs $snapshot)) }}
{{-   fail (printf "catalogSnapshot: %s is a relative path. Give it absolute, e.g. %s -- it is read from two places that resolve relative paths differently." $snapshot "/root/bundle/catalog-snapshot.tar.gz") }}
{{- end }}
{{- if and $snapshot (not (isFile $snapshot)) }}
{{-   fail (printf "catalogSnapshot: %s is not a file on this machine. It is the bundle's catalog-snapshot.tar.gz, read where helmfile runs -- point catalogSnapshot at it, or set it empty to sync from GitHub instead." $snapshot) }}
{{- end }}
{{- if $snapshot }}
sync:
  enabled: false
snapshot:
  configMap: catalog-mirror-snapshot
  key: snapshot.tar.gz
  # A new bundle is a new snapshot: roll the pod so it is unpacked.
  checksum: {{ readFile $snapshot | sha256sum | quote }}
persistence:
  enabled: false
{{- else }}
persistence:
  enabled: {{ .Values.storage.persistence }}
{{- if .Values.storage.persistence }}
  storageClass: {{ .Values.storage.className | quote }}
{{- end }}
{{- end }}
