{{- /* environments/*.yaml `higress:` -> the higress-llm chart (modelsphere/helm-charts):
       the gateway-wide plugin config. Routes come from ModelFleet objects via autoconfig.
       Consumers come from APIConsumer objects, also via autoconfig. */}}
{{- $h := .Values.higress }}
globalAuth: {{ $h.globalAuth }}
backendRouter: {{ toJson $h.backendRouter }}
streamGuard: {{ toJson $h.streamGuard }}
plugins: {{ toJson $h.plugins }}
