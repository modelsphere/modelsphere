bodylog:
  # Fully qualified, and not by preference: nginx's resolver does NOT apply the
  # search domains from /etc/resolv.conf, so a short Service name never resolves
  # in the cosocket that ships the frames -- and that failure is silent. The
  # logger reports frames written and none dropped, openresty logs no error, and
  # bodylog simply receives nothing. Measured on a test cluster: with
  # `bodylog.llm-route.svc` not one request was recorded; with the name below,
  # the first request landed in /data/bodylog/<date>/<hour>.jsonl.
  #
  # Empty when bodylog is not installed: openresty then captures and sends
  # nothing, which is what enabled.bodylog: false should mean.
  host: {{ if .Values.enabled.bodylog }}"bodylog.{{ .Values.namespaces.llmRoute }}.svc.cluster.local"{{ else }}""{{ end }}
fullnameOverride: openresty
image:
  repository: {{ .Values.registry }}/llm-openresty
  # The chart's own version: the two are released together. Taken from
  # versions.openresty rather than written here, so that an environment
  # pinning another chart gets that chart's image as well.
  tag: {{ .Values.versions.openresty | quote }}
# The two sidecars autoconfig injects have image names that differ from their
# repository name, but they follow registry the same way. They are autoconfig's,
# so they follow versions.autoconfig too, as CART's do in
# models/images.yaml.gotmpl. Written here they drifted from it (0.3.47 beside
# an autoconfig at 0.4.0), and an environment pinning an older autoconfig got
# sidecars from a newer one.
reload:
  image: {{ printf "%s/autoconfig-reload:%s" .Values.registry .Values.versions.autoconfig | quote }}
ha:
  image: {{ printf "%s/autoconfig-hagate:%s" .Values.registry .Values.versions.autoconfig | quote }}
